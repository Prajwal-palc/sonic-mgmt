Value remote (\S+)
Value refid (\S+)
Value st (\d+)
Value t (\S+)
Value when (\S+)
Value poll (\S+)
Value reach (\S+)
Value delay (\S+)
Value offset (\S+)
Value jitter (\S+)

Start
  # Match header line: remote                       refid            st   t  when   poll   reach  delay  offset       jitter
  ^\s*remote\s+refid\s+st\s+t\s+when\s+poll\s+reach\s+delay\s+offset\s+jitter\s*$$
  # Skip separator line
  ^(=+\s*)*$$
  # Match data line: 192.168.100.175              -                5    u   -      6      -      -0.0   -0.0         -
  ^\s*${remote}\s+${refid}\s+${st}\s+${t}\s+${when}\s+${poll}\s+${reach}\s+${delay}\s+${offset}\s+${jitter}\s*$$ -> Record
  # Skip footer line with symbols explanation
  ^\s*\*.*master.*\#.*master.*\+.*selected.*-.*candidate.*~.*configured\s*$$
