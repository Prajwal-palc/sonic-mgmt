<!DOCTYPE CLISH_MODULE [
]>
<CLISH_MODULE xmlns="http://www.dellemc.com/sonic/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xsi:schemaLocation="http://www.dellemc.com/sonic/XMLSchema http://www.dellemc.com/sonic/XMLSchema/clish.xsd">

  <!-- ============================================ -->
  <!-- Parameter Type Definitions                   -->
  <!-- ============================================ -->

  <!-- NTP Authentication Types: md5, sha1, sha256, sha384, sha512 -->
  <PTYPE name="NTP_AUTHENTICATION_TYPE" method="select" pattern="md5(md5) sha1(sha1) sha256(sha256) sha384(sha384) sha512(sha512)" help="Authentication encryption type"/>

  <!-- NTP Version: 3 or 4 -->
  <PTYPE name="NTP_VERSION" method="integer" pattern="3..4" help="NTP protocol version (3 or 4)"/>

  <!-- NTP Association Type: server or pool -->
  <PTYPE name="NTP_ASSOCIATION_TYPE" method="select" pattern="server(server) pool(pool)" help="NTP association type"/>

  <!-- String for passwords -->
  <PTYPE name="STRING_PASSWORD" pattern="[^|]+" help="Password string"/>

  <!-- ============================================ -->
  <!-- Show Commands (enable-view)                  -->
  <!-- ============================================ -->

  <VIEW name="enable-view">

    <!-- Parent command -->
    <COMMAND name="show ntp" help="Display NTP information"/>

    <!-- show ntp global -->
    <COMMAND name="show ntp global" help="Display NTP global configuration" mode="subcommand" ptype="SUBCOMMAND">
      <ACTION> python3 $SONIC_CLI_ROOT/sonic-cli-ntp.py get_ntp_global show_ntp.j2 </ACTION>
      <xi:include href="include/pipe.xml"/>
    </COMMAND>

    <!-- show ntp server -->
    <COMMAND name="show ntp server" help="Display configured NTP servers" mode="subcommand" ptype="SUBCOMMAND">
      <ACTION> python3 $SONIC_CLI_ROOT/sonic-cli-ntp.py get_ntp_server show_ntp.j2 </ACTION>
      <xi:include href="include/pipe.xml"/>
    </COMMAND>

    <!-- show ntp associations -->
    <COMMAND name="show ntp associations" help="Display NTP associations" mode="subcommand" ptype="SUBCOMMAND">
      <ACTION> python3 $SONIC_CLI_ROOT/sonic-cli-ntp.py get_ntp_associations show_ntp.j2 </ACTION>
      <xi:include href="include/pipe.xml"/>
    </COMMAND>

  </VIEW>

  <!-- ============================================ -->
  <!-- Configuration Commands (configure-view)      -->
  <!-- ============================================ -->

  <VIEW name="configure-view">

    <!-- Parent commands -->
    <COMMAND name="ntp" help="Configure NTP"/>
    <COMMAND name="no ntp" help="Delete NTP configuration"/>

    <!-- ============================================ -->
    <!-- NTP Enable/Disable                           -->
    <!-- ============================================ -->

    <COMMAND name="ntp enable" help="Enable NTP service">
      <ACTION> python3 $SONIC_CLI_ROOT/sonic-cli-ntp.py set_ntp_enabled True </ACTION>
    </COMMAND>

    <COMMAND name="no ntp enable" help="Disable NTP service">
      <ACTION> python3 $SONIC_CLI_ROOT/sonic-cli-ntp.py set_ntp_enabled False </ACTION>
    </COMMAND>

    <!-- ============================================ -->
    <!-- NTP Authentication                           -->
    <!-- ============================================ -->

    <COMMAND name="ntp authenticate" help="Enable NTP authentication">
      <ACTION> python3 $SONIC_CLI_ROOT/sonic-cli-ntp.py set_ntp_authentication True </ACTION>
    </COMMAND>

    <COMMAND name="no ntp authenticate" help="Disable NTP authentication">
      <ACTION> python3 $SONIC_CLI_ROOT/sonic-cli-ntp.py set_ntp_authentication False </ACTION>
    </COMMAND>

    <!-- ============================================ -->
    <!-- NTP Authentication Key                       -->
    <!-- ============================================ -->

    <COMMAND name="ntp authentication-key" help="Configure NTP authentication key">
      <PARAM name="key-id" ptype="RANGE_1_65535" help="Key ID (1-65535)"/>
      <PARAM name="auth-type" ptype="NTP_AUTHENTICATION_TYPE" help="Authentication type"/>
      <PARAM name="password" ptype="STRING_PASSWORD" help="Authentication password"/>
      <PARAM name="encrypted" ptype="SUBCOMMAND" mode="switch" help="Password is already encrypted" optional="true"/>
      <ACTION> python3 $SONIC_CLI_ROOT/sonic-cli-ntp.py set_ntp_authentication_key ${key-id} ${auth-type} ${password} ${encrypted} </ACTION>
    </COMMAND>

    <COMMAND name="no ntp authentication-key" help="Delete NTP authentication key">
      <PARAM name="key-id" ptype="RANGE_1_65535" help="Key ID (1-65535)"/>
      <ACTION> python3 $SONIC_CLI_ROOT/sonic-cli-ntp.py delete_ntp_authentication_key ${key-id} </ACTION>
    </COMMAND>

    <!-- ============================================ -->
    <!-- NTP Trusted Key                              -->
    <!-- ============================================ -->

    <COMMAND name="ntp trusted-key" help="Configure NTP trusted authentication key">
      <PARAM name="key-id" ptype="RANGE_1_65535" help="Key ID (1-65535)"/>
      <ACTION> python3 $SONIC_CLI_ROOT/sonic-cli-ntp.py set_ntp_trusted_key ${key-id} </ACTION>
    </COMMAND>

    <COMMAND name="no ntp trusted-key" help="Delete NTP trusted key">
      <PARAM name="key-id" ptype="RANGE_1_65535" help="Key ID (1-65535)"/>
      <ACTION> python3 $SONIC_CLI_ROOT/sonic-cli-ntp.py delete_ntp_trusted_key ${key-id} </ACTION>
    </COMMAND>

    <!-- ============================================ -->
    <!-- NTP Server Configuration                     -->
    <!-- ============================================ -->

    <COMMAND name="ntp server" help="Configure NTP server">
      <PARAM name="server-addr" ptype="STRING" help="NTP server IP address or hostname"/>
      <PARAM name="version" ptype="SUBCOMMAND" mode="subcommand" help="NTP protocol version" optional="true">
        <PARAM name="version-value" ptype="NTP_VERSION" help="Version number (3 or 4)"/>
      </PARAM>
      <PARAM name="association" ptype="SUBCOMMAND" mode="subcommand" help="Association type" optional="true">
        <PARAM name="assoc-value" ptype="NTP_ASSOCIATION_TYPE" help="Association mode (server or pool)"/>
      </PARAM>
      <PARAM name="iburst" ptype="SUBCOMMAND" mode="switch" help="Enable burst synchronization" optional="true"/>
      <PARAM name="key" ptype="SUBCOMMAND" mode="subcommand" help="Authentication key" optional="true">
        <PARAM name="key-value" ptype="RANGE_1_65535" help="Key ID (1-65535)"/>
      </PARAM>
      <PARAM name="prefer" ptype="SUBCOMMAND" mode="switch" help="Prefer this server" optional="true"/>
      <ACTION> python3 $SONIC_CLI_ROOT/sonic-cli-ntp.py set_ntp_server ${server-addr} version:${version-value} association-type:${assoc-value} iburst:${iburst} key:${key-value} prefer:${prefer} </ACTION>
    </COMMAND>

    <COMMAND name="no ntp server" help="Delete NTP server">
      <PARAM name="server-addr" ptype="STRING" help="NTP server IP address or hostname"/>
      <ACTION> python3 $SONIC_CLI_ROOT/sonic-cli-ntp.py delete_ntp_server ${server-addr} </ACTION>
    </COMMAND>

    <!-- ============================================ -->
    <!-- NTP Source Interface                         -->
    <!-- ============================================ -->

    <COMMAND name="ntp source-interface" help="Configure NTP source interface" ptype="SUBCOMMAND" mode="subcommand">
      <PARAM name="ifname" ptype="STRING" help="Interface name (e.g., Ethernet0, Management0)"/>
      <ACTION> python3 $SONIC_CLI_ROOT/sonic-cli-ntp.py set_ntp_source ${ifname} </ACTION>
    </COMMAND>

    <COMMAND name="no ntp source-interface" help="Delete NTP source interface">
      <ACTION> python3 $SONIC_CLI_ROOT/sonic-cli-ntp.py delete_ntp_source </ACTION>
    </COMMAND>

    <!-- ============================================ -->
    <!-- NTP VRF                                      -->
    <!-- ============================================ -->

    <COMMAND name="ntp vrf" help="Enable NTP on VRF">
      <PARAM name="vrf-name" ptype="STRING" help="VRF name (mgmt or default)"/>
      <ACTION> python3 $SONIC_CLI_ROOT/sonic-cli-ntp.py set_ntp_vrf ${vrf-name} </ACTION>
    </COMMAND>

    <COMMAND name="no ntp vrf" help="Disable NTP on VRF">
      <ACTION> python3 $SONIC_CLI_ROOT/sonic-cli-ntp.py delete_ntp_vrf </ACTION>
    </COMMAND>

  </VIEW>

</CLISH_MODULE>
